{
  "manifest_version": 3,
  "name": "SidebarNote",
  "version": "1.0.0",
  "description": "Uma extensão Chrome para gerenciar notas no painel lateral do navegador",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "icons": {
    "16": "icons/icon-16.svg",
    "32": "icons/icon-32.svg",
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "action": {
    "default_title": "Abrir SidebarNote"
  },
  "background": {
    "service_worker": "background.js"
  }
}